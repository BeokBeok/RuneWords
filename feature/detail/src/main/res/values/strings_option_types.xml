<?xml version="1.0" encoding="utf-8"?>
<!--
    룬워드 옵션 형식 문자열.
    - 옵션 형식 하나에 문자열 하나만 둔다. 같은 의미의 문자열을 새로 만들지 않는다.
    - 영어는 첫 글자만 문장 규칙에 따라 대문자로 쓰고, 나머지는 소문자로 쓴다. (기술 이름은 예외)
    - 인자는 위치 지정자(%1$s, %2$s)로 쓴다. 퍼센트 기호는 %% 로 쓴다.
    - 캐릭터 레벨 비례 수치는 계산 결과(예: 3-297)가 아니라 계수로 쓴다. 예: (character level x 3)
    - values-ko/strings_option_types.xml 에 같은 이름의 문자열을 반드시 추가한다.
-->
<resources>
    <!-- 수치 표기 -->
    <string name="option_value_range">%1$s-%2$s</string>
    <string name="option_value_per_level">(character level x %1$s)</string>
    <string name="option_value_per_level_range">(character level x %1$s-%2$s)</string>

    <!-- 구역 제목 -->
    <string name="option_section_body_armor">Body Armor</string>
