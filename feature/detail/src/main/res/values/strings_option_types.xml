    <string name="option_type_cannot_be_frozen">Cannot be frozen</string>
    <string name="option_type_chance_to_cast_when_struck">%1$s%% chance to cast level %2$s %3$s when struck</string>
    <string name="option_type_crushing_blow">%1$s%% chance of crushing blow</string>
    <string name="option_type_damage_reduced">Damage reduced by %1$s</string>
